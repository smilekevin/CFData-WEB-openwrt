#!/bin/sh /etc/rc.common
# ============================================================
# CFData-Web 常驻服务 (OpenWrt procd)
# Cloudflare IP 优选 Web UI, 监听 0.0.0.0:13335 (实测全网卡,
# 程序日志里的 localhost 仅为显示文案), 局域网可直接访问
# 崩溃自动拉起 + 开机自启
#
# 可选参数: 若存在 /opt/cfdata/ARGS 文件, 其内容作为附加命令行参数
#   传给程序, 例如: -user admin -password xxxx   (启用 Web 登录认证)
#   或: -port 13336                              (改端口, 需同步改反代)
#
# 安装: cp cfdata.init /etc/init.d/cfdata && chmod +x /etc/init.d/cfdata
#        /etc/init.d/cfdata enable && /etc/init.d/cfdata start
# 状态: /etc/init.d/cfdata status
# ============================================================

USE_PROCD=1

START=99
STOP=10

PROG=/opt/cfdata/cfdata
WRAPPER=/opt/cfdata/run.sh
ARGS_FILE=/opt/cfdata/ARGS

start_service() {
    local port
    # 端口来自 uci: /etc/config/cfdata -> cfdata.main.port (默认 13335)
    port=$(uci -q get cfdata.main.port 2>/dev/null)
    [ -z "$port" ] && port=13335

    # 部分固件的 procd 不生效 workdir 参数 (程序 cwd 落在 / 导致写文件 permission denied),
    # 生成启动包装脚本: 无论谁启动都先 cd 到数据目录再 exec 程序
    if [ ! -x "$WRAPPER" ]; then
        echo '#!/bin/sh' > "$WRAPPER"
        echo 'cd "$(dirname "$0")"' >> "$WRAPPER"
        echo 'exec "$(dirname "$0")/cfdata" "$@"' >> "$WRAPPER"
        chmod +x "$WRAPPER"
    fi

    procd_open_instance
    # 主程序 (前台进程, 由 procd 托管; 经 run.sh 包装保证工作目录正确)
    procd_set_param command "$WRAPPER"
    # 专用用户 cfdata (uid 1010): 配合 OpenClash 黑白名单按用户过滤流量;
    # 用户不存在时自动回退 root, 不影响无 OpenClash 的部署
    grep -q '^cfdata:' /etc/passwd 2>/dev/null && procd_set_param user cfdata
    procd_append_param command -port "$port"
    # 可选附加参数 (ARGS 文件, 空格分隔, 高级用法如 -user/-password)
    [ -f "$ARGS_FILE" ] && procd_append_param command $(cat "$ARGS_FILE")
    # 崩溃后自动重启: 3600秒内最多重试5次, 每次间隔5秒
    procd_set_param respawn 3600 5 5
    # 工作目录: 由 run.sh 的 cd 保证 (workdir 参数在此保留, 作双保险)
    procd_set_param workdir /opt/cfdata
    # 日志进 logread (syslog), 可用 logread -e cfdata 查看
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
