#!/bin/sh /etc/rc.common
# ============================================================
# CFData-Web 常驻服务 (OpenWrt procd)
# Cloudflare IP 优选 Web UI, 默认监听 127.0.0.1:13335
# 崩溃自动拉起 + 开机自启
#
# 安装: cp cfdata.init /etc/init.d/cfdata && chmod +x /etc/init.d/cfdata
#        /etc/init.d/cfdata enable && /etc/init.d/cfdata start
# 状态: /etc/init.d/cfdata status
# ============================================================

USE_PROCD=1

START=99
STOP=10

PROG=/opt/cfdata/cfdata

start_service() {
    procd_open_instance
    # 主程序 (前台进程, 由 procd 托管)
    procd_set_param command "$PROG"
    # 崩溃后自动重启: 3600秒内最多重试5次, 每次间隔5秒
    procd_set_param respawn 3600 5 5
    # 工作目录: 配置文件/缓存 (cfdata-config.json, locations.json 等) 存这里
    procd_set_param workdir /opt/cfdata
    # 日志进 logread (syslog), 可用 logread -e cfdata 查看
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
